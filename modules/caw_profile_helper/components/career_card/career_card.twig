{% set stat_header = "h2" %}
{% if header_tag == "h2" %}
  {% set stat_header = "h3" %}
{% endif %}
{% if header_tag == "h3" %}
  {% set stat_header = "h4" %}
{% endif %}
<article{{ attributes.addClass('caw-careers-card su-card su-card--horizontal') }}>

  <div class="caw-careers-card--left">
    {% block image %}
      {{ image }}
    {% endblock %}
  </div>


  <div class="caw-careers-card--right su-card__contents">
    <div class="su-card__contents-wrapper">
      <{{ header_tag }}>
      {% if url %}<a href="{{ url }}">{% endif %}
        {{ title }}
        {% if url %}</a>{% endif %}
    </{{ header_tag }}>

    {% if job_title %}
      <div class="caw-careers-card--job-title">
        {{ job_title }}
      </div>
    {% endif %}
  </div>
  </div>

  <div class="caw-careers-card--years-honored">
    {% if years %}
      <div class="caw-careers-card--years">
        <{{ stat_header }}>Years at Stanford</{{ stat_header }}>
        {{ years }}
      </div>
    {% endif %}
    {% if honored %}
      <div class="caw-careers-card--honored">
        <{{ stat_header }}>Honored</{{ stat_header }}>
        {{ honored }}
      </div>
    {% endif %}
  </div>
</article>
